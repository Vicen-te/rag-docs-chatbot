DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/rag

# Agent / LLM
# LLM_PROVIDER selects the transport: "ollama" (native /api/chat,
# honours num_ctx) or "openai" (any OpenAI-compatible endpoint via
# OLLAMA_BASE_URL + OLLAMA_API_KEY).
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_NUM_CTX=32768
# AGENT_TOP_K=12
# AGENT_MAX_VERIFY_RETRIES=2
# AGENT_USE_RERANKER=false
# AGENT_RERANK_CANDIDATES_MULTIPLIER=3
# AGENT_QUERY_DECOMPOSITION=false

# Use only cached Hugging Face models (offline); skips network
# revalidation on every run. The embedder/reranker are downloaded
# once on first ingest.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Optional RAG tunables. Defaults are sensible; override only if you
# know what you are doing -- changing EMBEDDING_MODEL or EMBEDDING_DIM
# requires re-ingesting the corpus.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# KB_PARENT_CHUNK_SIZE=2048
# KB_CHILD_CHUNK_SIZE=512
# KB_CHUNK_OVERLAP=64
# KB_RRF_K=60
# KB_SEMANTIC_WEIGHT=0.7
# KB_LEXICAL_WEIGHT=0.3
# KB_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Observability (optional). Set LANGSMITH_API_KEY to enable tracing.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rag-docs-chatbot

# Ragas evaluation judge. "ollama" reuses the local LLM (free but a
# weak structured-output judge -> NaN metrics). "openai" and
# "anthropic" route to those APIs (fast, reliable, pay-per-use).
# RAGAS_JUDGE_PROVIDER=ollama
# RAGAS_JUDGE_MODEL=                 # empty -> OLLAMA_MODEL / gpt-4o-mini / claude-haiku-4-5
# OPENAI_API_KEY=                    # only when provider=openai
# ANTHROPIC_API_KEY=                 # only when provider=anthropic
