DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/rag

# Optional RAG tunables. Defaults are sensible; override only if you
# know what you are doing -- changing EMBEDDING_MODEL or EMBEDDING_DIM
# requires re-ingesting the corpus.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# KB_PARENT_CHUNK_SIZE=2048
# KB_CHILD_CHUNK_SIZE=512
# KB_CHUNK_OVERLAP=64
# KB_RRF_K=60
# KB_SEMANTIC_WEIGHT=0.7
# KB_LEXICAL_WEIGHT=0.3
# KB_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
